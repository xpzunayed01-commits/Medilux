{
  "entities": {
    "admin": {
      "title": "Admin",
      "description": "Administrator account",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "uid": { "type": "string" }
      },
      "required": ["email", "uid"]
    },
    "product": {
      "title": "Product",
      "description": "E-commerce product entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "descriptor": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "regularPrice": { "type": "number" },
        "image": { "type": "string" },
        "images": { "type": "array" },
        "category": { "type": "string" },
        "stock": { "type": "number" },
        "isNew": { "type": "boolean" },
        "isBestseller": { "type": "boolean" },
        "isFeatured": { "type": "boolean" },
        "isOutOfStock": { "type": "boolean" },
        "ingredients": { "type": "string" },
        "howToUse": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "price", "category"]
    },
    "category": {
      "title": "Category",
      "description": "Product collection category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "isHidden": { "type": "boolean" },
        "order": { "type": "number" }
      },
      "required": ["name", "description", "image"]
    },
    "order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerEmail": { "type": "string" },
        "streetAddress": { "type": "string" },
        "city": { "type": "string" },
        "postalCode": { "type": "string" },
        "notes": { "type": "string" },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "deliveryFee": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["orderNumber", "customerName", "customerPhone", "streetAddress", "city", "items", "total", "status"]
    },
    "customer": {
      "title": "Customer",
      "description": "Customer directory profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "totalOrders": { "type": "number" },
        "totalSpent": { "type": "number" },
        "lastOrderDate": { "type": "string" },
        "orders": { "type": "array" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "phone"]
    },
    "siteSettings": {
      "title": "SiteSettings",
      "description": "Store configuration and site content",
      "type": "object",
      "properties": {
        "storeName": { "type": "string" },
        "tagline": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "currency": { "type": "string" },
        "deliveryFeeDhaka": { "type": "number" },
        "deliveryFeeOutside": { "type": "number" },
        "freeDeliveryThreshold": { "type": "number" },
        "codEnabled": { "type": "boolean" },
        "bkashNumber": { "type": "string" },
        "facebookUrl": { "type": "string" },
        "instagramUrl": { "type": "string" },
        "whatsappNumber": { "type": "string" }
      },
      "required": ["storeName"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": "admin",
      "description": "List of administrators"
    },
    "/products/{productId}": {
      "schema": "product",
      "description": "Product catalog"
    },
    "/categories/{categoryId}": {
      "schema": "category",
      "description": "Store categories"
    },
    "/orders/{orderId}": {
      "schema": "order",
      "description": "Customer orders"
    },
    "/customers/{customerId}": {
      "schema": "customer",
      "description": "Customer profiles"
    },
    "/settings/{settingId}": {
      "schema": "siteSettings",
      "description": "Store settings and website content"
    }
  }
}
