rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins collection
    match /admins/{adminId} {
      allow read, write: if true;
    }

    // Products catalog: everyone can view products, store manager can create/edit/delete
    match /products/{productId} {
      allow read, write: if true;
    }

    // Categories: everyone can view, store manager can manage
    match /categories/{categoryId} {
      allow read, write: if true;
    }

    // Orders: customers can place orders, admin can view/update/manage
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Customers: directory created on order, admin can view/manage
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Store settings & website content: public read, store manager write
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Audit logs
    match /auditLogs/{logId} {
      allow read, write: if true;
    }
  }
}

