rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Products
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow write: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
    }

    // Customers
    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }
    
    // Audit Logs
    match /auditLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
